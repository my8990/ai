.page { padding: 24rpx; background: var(--bg-page); min-height: 100vh; }

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 22rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.4rpx;
}
.btn-create {
  font-size: 24rpx;
  color: #fff;
  background: var(--primary);
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.btn-create:active { opacity: 0.88; }

.filter-bar {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.filter-scroll { white-space: nowrap; }
.filter-group { display: inline-flex; gap: 10rpx; }
.filter-divider {
  display: inline-block;
  width: 1rpx;
  height: 32rpx;
  background: var(--line);
  margin: 0 16rpx;
  vertical-align: middle;
}
.chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  color: var(--text-2);
  background: #f3f4f6;
  border-radius: 999rpx;
  transition: all 0.15s;
}
.chip.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.role-badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: 600;
  line-height: 1.4;
}
.role-badge.teacher {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
}
.role-badge.teacher.sm {
  font-size: 18rpx;
  padding: 0 10rpx;
}
.avatar.teacher {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}
.author-row { display: flex; align-items: center; }

.loading-tip { text-align: center; padding: 80rpx 0; color: var(--text-3); font-size: 26rpx; }
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-box-icon {
  width: 110rpx; height: 92rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-text { font-size: 26rpx; color: var(--text-3); }

.post-list { display: flex; flex-direction: column; gap: 16rpx; }
.post-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
}
.post-head { display: flex; align-items: center; gap: 16rpx; }
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  color: var(--primary-dark);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.post-author { flex: 1; min-width: 0; }
.author-name { font-size: 26rpx; font-weight: 600; color: var(--text-1); display: block; }
.author-meta { font-size: 21rpx; color: var(--text-3); }
.op.danger {
  font-size: 23rpx;
  color: var(--danger);
  background: var(--danger-bg);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.post-content {
  font-size: 27rpx;
  color: var(--text-1);
  margin-top: 16rpx;
  display: block;
  line-height: 1.7;
  word-break: break-all;
}

.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.post-img { width: 150rpx; height: 150rpx; border-radius: 12rpx; background: #f1f5f9; }
.img-wrap { position: relative; }
.img-del {
  position: absolute;
  top: -10rpx; right: -10rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: rgba(15,23,42,0.65);
  color: #fff;
  font-size: 26rpx;
  text-align: center;
  line-height: 36rpx;
}
.img-add {
  width: 150rpx; height: 150rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  color: #cbd5e1;
}

.post-actions {
  display: flex;
  gap: 40rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f4f6fb;
}
.action { font-size: 23rpx; color: var(--text-3); padding: 4rpx 0; }
.action.liked { color: var(--danger); font-weight: 500; }

.comment-list { margin-top: 16rpx; background: #f8fafc; border-radius: 14rpx; padding: 18rpx; }
.comment-item { padding: 8rpx 0; }
.comment-head { display: flex; align-items: center; gap: 12rpx; }
.c-author { font-size: 23rpx; font-weight: 600; color: var(--primary-dark); }
.c-role {
  font-size: 19rpx;
  color: var(--primary-dark);
  background: var(--primary-bg);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
}
.c-time { font-size: 19rpx; color: var(--text-3); flex: 1; }
.c-content {
  font-size: 25rpx;
  color: var(--text-1);
  margin-top: 6rpx;
  display: block;
  word-break: break-all;
  line-height: 1.6;
}

.comment-input-row { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.comment-input {
  flex: 1;
  font-size: 25rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
}
.comment-send { font-size: 25rpx; color: var(--primary); font-weight: 600; }

.textarea {
  width: 100%;
  font-size: 27rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx;
  background: #f8fafc;
  min-height: 180rpx;
  box-sizing: border-box;
}
.btn-cancel {
  font-size: 25rpx;
  color: var(--text-2);
  padding: 14rpx 36rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}
.btn-confirm {
  font-size: 25rpx;
  color: #fff;
  padding: 14rpx 36rpx;
  border-radius: 12rpx;
  background: var(--primary);
}