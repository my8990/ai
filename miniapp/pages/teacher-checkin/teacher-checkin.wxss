.page { padding: 0 24rpx 40rpx; background: var(--bg-page); min-height: 100vh; }

.hero {
  margin: 0 -24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.hero-bg { display: none; }
.hero-content {
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx 32rpx;
}
.hero-icon-wrap {
  width: 84rpx; height: 84rpx;
  border-radius: 18rpx;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.hero-icon {
  width: 40rpx; height: 40rpx;
  border: 3rpx solid #6366f1;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}
.hero-icon::before {
  content: '';
  position: absolute;
  left: 50%; top: 6rpx;
  transform: translateX(-50%);
  width: 2rpx; height: 13rpx;
  background: #6366f1;
}
.hero-icon::after {
  content: '';
  position: absolute;
  left: 6rpx; top: 50%;
  transform: translateY(-50%);
  width: 13rpx; height: 2rpx;
  background: #6366f1;
}
.hero-info { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.hero-title { font-size: 34rpx; color: var(--text-1); font-weight: 700; letter-spacing: -0.3rpx; }
.hero-sub { font-size: 22rpx; color: var(--text-3); }

.selector-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 22rpx;
  margin-bottom: 20rpx;
}
.selector-label { font-size: 23rpx; color: var(--text-3); margin-bottom: 12rpx; display: block; }
.selector-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  background: #f8fafc;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}
.selector-value.empty { opacity: 0.6; }
.selector-text { font-size: 27rpx; color: var(--text-1); font-weight: 500; }
.selector-arrow {
  width: 14rpx; height: 14rpx;
  border-right: 3rpx solid #94a3b8;
  border-bottom: 3rpx solid #94a3b8;
  transform: rotate(45deg);
}

.action-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 0;
  border-radius: 14rpx;
}
.action-btn.primary {
  background: var(--primary);
}
.action-btn.secondary {
  background: #fff;
  border: 1rpx solid var(--line);
}
.action-btn-icon {
  position: relative;
}
.action-btn-icon.add {
  width: 26rpx; height: 26rpx;
}
.action-btn-icon.add::before {
  content: '';
  position: absolute;
  left: 50%; top: 0;
  transform: translateX(-50%);
  width: 2rpx; height: 26rpx;
  background: #fff;
}
.action-btn-icon.add::after {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 26rpx; height: 2rpx;
  background: #fff;
}
.action-btn-icon.refresh {
  width: 24rpx; height: 24rpx;
  border: 2rpx solid #6366f1;
  border-radius: 50%;
  border-top-color: transparent;
  box-sizing: border-box;
}
.action-btn-text { font-size: 27rpx; font-weight: 600; }
.action-btn.primary .action-btn-text { color: #fff; }
.action-btn.secondary .action-btn-text { color: var(--text-2); }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 0;
}
.empty-icon {
  width: 96rpx; height: 96rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 50%;
  margin-bottom: 20rpx;
  opacity: 0.55;
}
.empty-text { font-size: 26rpx; color: var(--text-3); margin-bottom: 8rpx; }
.empty-hint { font-size: 23rpx; color: var(--text-4); }

.checkin-list { display: flex; flex-direction: column; gap: 16rpx; }
.checkin-card {
  display: flex;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  overflow: hidden;
}
.card-left-bar { display: none; }
.card-body { flex: 1; padding: 24rpx; }
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  gap: 12rpx;
}
.card-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.card-status.active { background: var(--primary-bg); color: var(--primary-dark); }
.card-status.ended { background: #f1f5f9; color: var(--text-3); }
.card-info { display: flex; gap: 12rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.info-tag {
  font-size: 22rpx;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: var(--text-2);
}
.info-tag.code {
  font-family: 'Courier New', monospace;
  font-weight: 700;
  color: var(--primary-dark);
  background: var(--primary-bg);
}
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.card-count { font-size: 23rpx; color: var(--text-2); font-weight: 500; }
.card-time { font-size: 21rpx; color: var(--text-3); }
.card-btns {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f4f6fb;
}
.btn-detail, .btn-end {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}
.btn-detail {
  background: var(--primary-bg);
  color: var(--primary-dark);
}
.btn-end {
  background: var(--danger-bg);
  color: var(--danger);
}
.btn-text { font-size: 23rpx; }

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f6fb;
}
.detail-row .label { width: 140rpx; font-size: 25rpx; color: var(--text-3); flex-shrink: 0; }
.detail-row .val { font-size: 25rpx; color: var(--text-1); flex: 1; }
.detail-row .val.code {
  font-family: 'Courier New', monospace;
  font-weight: 700;
  color: var(--primary-dark);
  letter-spacing: 3rpx;
}
.record-title { font-size: 27rpx; font-weight: 700; color: var(--text-1); margin: 24rpx 0 12rpx; display: block; }
.record-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f6fb;
  gap: 12rpx;
}
.record-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.record-dot.yes { background: var(--success); }
.record-dot.no { background: #e2e8f0; }
.r-name { font-size: 25rpx; color: var(--text-1); flex: 1; }
.r-no { font-size: 22rpx; color: var(--text-3); }
.r-status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.r-status.yes { background: var(--success-bg); color: var(--success); }
.r-status.no { background: var(--danger-bg); color: var(--danger); }
.r-time { font-size: 20rpx; color: var(--text-3); flex-shrink: 0; }
.empty-tip { text-align: center; padding: 30rpx 0; color: var(--text-3); font-size: 24rpx; }

.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15,23,42,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
  padding: 0 40rpx;
}
.modal {
  background: #fff;
  border-radius: 22rpx;
  padding: 36rpx 30rpx 30rpx;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 26rpx;
  display: block;
  color: var(--text-1);
}

.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 25rpx; color: var(--text-2); margin-bottom: 10rpx; display: block; font-weight: 500; }
.form-input {
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 27rpx;
  background: #f8fafc;
}
.radio-group { display: flex; gap: 14rpx; margin-top: 8rpx; }
.radio {
  font-size: 25rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--text-2);
  background: #fff;
}
.radio.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

.modal-btns {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 28rpx;
}
.modal-btn {
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 500;
}
.modal-btn.cancel { background: #f1f5f9; color: var(--text-2); }
.modal-btn.confirm { background: var(--primary); color: #fff; }
.modal-btn.close { background: #f1f5f9; color: var(--text-2); }