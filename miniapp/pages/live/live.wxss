.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

.live-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx 24rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.course-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.live-title {
  font-size: 24rpx;
  color: var(--text-3);
}

.live-status {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.live-header-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.live-conn {
  font-size: 19rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: var(--text-3);
}

.live-conn.on {
  background: var(--primary-bg);
  color: var(--primary);
}

.live-stats {
  display: flex;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--line);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-dark);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.live-status.active {
  background: var(--success-bg);
  color: var(--success);
}

.live-status.ended {
  background: #f1f5f9;
  color: var(--text-3);
}

.quiz-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #eef2ff, #ecfdf5);
  border: 1rpx solid #c7d2fe;
}

.quiz-banner-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.quiz-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quiz-banner-meta {
  font-size: 22rpx;
  color: var(--text-3);
}

.quiz-banner-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  background: #6366f1;
}

.quiz-banner-btn.done {
  background: #e2e8f0;
  color: var(--text-3);
}

.slide-box {
  margin: 0 24rpx;
  background: #0f172a;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  padding: 12rpx;
}

.slide-image {
  width: 100%;
  border-radius: 12rpx;
}

.preload-image {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 2rpx;
  height: 2rpx;
  opacity: 0;
  pointer-events: none;
}

.waiting-box {
  margin: 0 24rpx;
  min-height: 420rpx;
  background: #fff;
  border: 1rpx dashed var(--line);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.waiting-icon {
  font-size: 56rpx;
}

.waiting-text {
  font-size: 26rpx;
  color: var(--text-3);
}

.ended-box {
  margin: 60rpx 24rpx 0;
  padding: 60rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.ended-icon {
  font-size: 56rpx;
}

.ended-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.ended-tip {
  font-size: 25rpx;
  color: var(--text-3);
  text-align: center;
}

.ended-btn {
  margin-top: 16rpx;
  padding: 18rpx 56rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.footer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.page-info {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.follow-tip {
  font-size: 23rpx;
  color: var(--text-3);
}

.interact-bar {
  display: flex;
  gap: 24rpx;
  margin: 20rpx 24rpx 0;
}

.interact-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 42rpx;
  background: #fff;
  border: 2rpx solid #dbe3ef;
  font-size: 28rpx;
  color: var(--text-1);
}

.interact-btn.on {
  background: #fff7e6;
  border-color: #f59e0b;
  color: #b45309;
}

.interact-btn.ask {
  background: #eef4ff;
  border-color: #c7d9ff;
  color: #1d4ed8;
}

.ask-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.ask-panel {
  width: 600rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
}

.ask-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 20rpx;
}

.ask-input {
  width: 100%;
  height: 180rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #f6f8fb;
  border-radius: 16rpx;
}

.ask-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.ask-cancel {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  background: #f1f5f9;
  font-size: 27rpx;
  color: var(--text-2);
}

.ask-submit {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  background: #2563eb;
  font-size: 27rpx;
  color: #fff;
}

.ask-submit.disabled {
  opacity: 0.6;
}