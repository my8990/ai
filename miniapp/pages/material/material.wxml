<view class="page">
  <status-bar />
  <view class="header-bar">
    <text class="title">课件资源</text>
    <view wx:if="{{role === 'teacher'}}" class="btn-create" bindtap="chooseFile">+ 上传课件</view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <view class="empty-box-icon"></view>
    <text class="empty-text">暂无课件</text>
  </view>

  <view wx:else class="mt-list">
    <view wx:for="{{list}}" wx:key="id" class="mt-card" bindtap="openFile" data-index="{{index}}">
      <view class="file-icon {{item.isImage ? 'image' : ''}}">{{item.fileIcon}}</view>
      <view class="mt-body">
        <view class="mt-top">
          <text class="mt-title">{{item.title}}</text>
          <text wx:if="{{item.status === 0}}" class="mt-status off">已下架</text>
        </view>
        <text class="mt-name">{{item.fileName || ''}}</text>
        <view class="mt-bottom">
          <text class="mt-meta">{{item.sizeText}}</text>
          <text class="mt-time">{{item.timeText}}</text>
        </view>
      </view>
      <view wx:if="{{role === 'teacher'}}" class="mt-ops">
        <text class="op" catchtap="handleToggle" data-id="{{item.id}}">{{item.status === 1 ? '下架' : '上架'}}</text>
        <text class="op danger" catchtap="handleDelete" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showCreate}}" class="modal-mask" bindtap="hideCreate">
    <view class="modal" catchtap="preventBubble">
      <text class="modal-title">填写课件信息</text>
      <view class="form-item">
        <text class="label">标题</text>
        <input class="input" placeholder="课件标题" value="{{createForm.title}}" bindinput="onTitleInput" />
      </view>
      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideCreate">取消</view>
        <view class="btn-confirm" bindtap="handleCreate">上传</view>
      </view>
    </view>
  </view>
</view>