.page { padding: 24rpx; background: var(--bg-page); min-height: 100vh; }
.info-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
}
.info-row { display: flex; padding: 15rpx 0; border-bottom: 1rpx solid #f4f6fb; }
.info-row:last-child { border-bottom: none; }
.label { width: 100rpx; font-size: 25rpx; color: var(--text-3); flex-shrink: 0; }
.value { font-size: 25rpx; color: var(--text-1); flex: 1; }
.value.desc { word-break: break-all; color: var(--text-2); line-height: 1.65; }
.expired-tip {
  background: var(--warning-bg);
  color: #b45309;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  margin-bottom: 22rpx;
  border-left: 6rpx solid var(--warning);
}
.form-section {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
}
.section-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
  display: block;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--line);
}
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 25rpx; color: var(--text-2); margin-bottom: 12rpx; display: block; font-weight: 500; }
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 27rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: #f8fafc;
  box-sizing: border-box;
}
.image-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.img-item { position: relative; width: 150rpx; height: 150rpx; }
.img { width: 100%; height: 100%; border-radius: 12rpx; }
.img-del {
  position: absolute;
  top: -8rpx; right: -8rpx;
  width: 34rpx; height: 34rpx;
  background: rgba(15,23,42,0.65);
  color: #fff;
  font-size: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add {
  width: 150rpx; height: 150rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-icon { font-size: 46rpx; color: #cbd5e1; }
.file-item { display: flex; align-items: center; gap: 12rpx; }
.file-name { font-size: 25rpx; color: var(--primary-dark); }
.file-del { font-size: 23rpx; color: var(--danger); padding: 4rpx 12rpx; }
.btn-upload {
  font-size: 25rpx;
  color: var(--primary-dark);
  padding: 12rpx 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  display: inline-block;
  background: #f8fafc;
}
.btn-submit {
  background: var(--primary);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
  padding: 26rpx;
  border-radius: 14rpx;
  margin-bottom: 22rpx;
}
.btn-submit:active { opacity: 0.9; }
.grade-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
}
.grade-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 16rpx;
  display: block;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--line);
}
.grade-row { display: flex; padding: 10rpx 0; }
.grade-label { width: 100rpx; font-size: 25rpx; color: var(--text-3); }
.grade-score { font-size: 32rpx; color: var(--primary-dark); font-weight: 700; }
.grade-val { font-size: 25rpx; color: var(--text-2); flex: 1; }