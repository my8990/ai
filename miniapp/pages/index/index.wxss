.home {
  min-height: 100vh;
  padding: 0 28rpx 180rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e9edff 0%, #f3f6fd 260rpx, #f5f7fb 520rpx);
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-top: 56rpx;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 28rpx;
  background: #fff;
  border-radius: 46rpx;
  min-width: 0;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.10);
}
.icon-search {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid var(--primary-light);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  margin-right: 18rpx;
}
.icon-search::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  background: var(--primary-light);
  transform: rotate(45deg);
  border-radius: 2rpx;
}
.search-input {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-1);
  height: 92rpx;
  min-width: 0;
}
.search-placeholder {
  color: var(--text-4);
  font-size: 26rpx;
}
.search-clear {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #e2e8f0;
  position: relative;
  flex-shrink: 0;
  margin-left: 10rpx;
}
.search-clear::before,
.search-clear::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
}
.search-clear::before { transform: translate(-50%, -50%) rotate(45deg); }
.search-clear::after { transform: translate(-50%, -50%) rotate(-45deg); }
.search-scan {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 26rpx rgba(99, 102, 241, 0.32);
}
.search-scan:active { opacity: 0.88; }
.icon-scan-sm {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #fff;
  border-radius: 9rpx;
  position: relative;
}
.icon-scan-sm::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #fff;
  border-radius: 3rpx;
}

/* ---------- 问候 ---------- */
.greet {
  margin: 44rpx 0 28rpx;
}
.greet-text {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -1rpx;
}

/* ---------- 扫码 / 签到 ---------- */
.quick-card {
  display: flex;
  gap: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(99, 102, 241, 0.10);
}
.quick-btn {
  flex: 1;
  height: 158rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}
.quick-btn.scan {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  box-shadow: 0 10rpx 24rpx rgba(99, 102, 241, 0.35);
}
.quick-btn.sign {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.32);
}
.quick-btn::before {
  content: '';
  position: absolute;
  right: -46rpx;
  bottom: -54rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}
.quick-btn::after {
  content: '';
  position: absolute;
  left: -34rpx;
  top: -40rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
}
.quick-btn-hover { opacity: 0.9; }
.quick-btn.loading { opacity: 0.75; }
.quick-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  position: relative;
  z-index: 1;
  animation: quick-spin 0.8s linear infinite;
}
@keyframes quick-spin {
  to { transform: rotate(360deg); }
}
.quick-icon {
  position: relative;
  z-index: 1;
}
.quick-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
  white-space: nowrap;
}
.icon-qr {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #fff;
  border-radius: 12rpx;
  position: relative;
}
.icon-qr::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 11rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #fff;
  border-radius: 3rpx;
}
.icon-sign {
  width: 54rpx;
  height: 54rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  position: relative;
}
.icon-sign::before {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 8rpx;
  width: 4rpx;
  height: 26rpx;
  background: #fff;
  transform-origin: bottom center;
  transform: rotate(-45deg);
  border-radius: 2rpx;
}

/* ---------- 区块标题 ---------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.section-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 0;
  letter-spacing: -0.5rpx;
  border-left: 8rpx solid var(--primary);
  padding-left: 16rpx;
  line-height: 1.15;
  border-radius: 4rpx;
}
.section-link {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

/* ---------- 最近访问 ---------- */
.visit-section {
  margin-top: 46rpx;
}
.visit-scroll {
  width: 100%;
  white-space: nowrap;
}
.visit-card {
  display: inline-block;
  width: 306rpx;
  margin-right: 22rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  vertical-align: top;
  white-space: normal;
  box-shadow: 0 12rpx 30rpx rgba(30, 41, 59, 0.07);
}
.visit-card:last-child { margin-right: 0; }
.visit-card:active { transform: scale(0.97); }
.visit-cover {
  height: 180rpx;
  background: linear-gradient(135deg, #dfe8ff 0%, #cfe0ff 55%, #d9e6ff 100%);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.visit-cover::before {
  content: '';
  position: absolute;
  right: -56rpx;
  top: -60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}
.visit-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.visit-illust {
  position: relative;
  width: 190rpx;
  height: 124rpx;
  z-index: 1;
}
.illust-screen {
  position: absolute;
  left: 40rpx;
  top: 0;
  width: 112rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 10rpx;
  box-shadow: 0 6rpx 14rpx rgba(99, 102, 241, 0.16);
}
.illust-screen::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 16rpx;
  width: 44rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #c7d2fe, #a5b4fc);
  border-radius: 4rpx;
}
.illust-screen::after {
  content: '';
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 26rpx;
  height: 4rpx;
  background: #e2e8f0;
  border-radius: 2rpx;
  box-shadow: 0 10rpx 0 #e2e8f0, 0 20rpx 0 #e2e8f0;
}
.illust-stand {
  position: absolute;
  left: 82rpx;
  top: 80rpx;
  width: 28rpx;
  height: 10rpx;
  background: #fff;
  border-radius: 0 0 4rpx 4rpx;
}
.illust-book {
  position: absolute;
  top: 88rpx;
  width: 60rpx;
  height: 26rpx;
  border-radius: 4rpx;
}
.illust-book.left {
  left: 10rpx;
  background: linear-gradient(135deg, #c7d2fe, #a5b4fc);
}
.illust-book.right {
  right: 6rpx;
  background: linear-gradient(135deg, #a5b4fc, #818cf8);
}
.visit-body {
  padding: 22rpx 22rpx 26rpx;
}
.visit-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.visit-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  position: relative;
  flex-shrink: 0;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.visit-badge::before {
  content: '';
  width: 16rpx;
  height: 12rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  border-radius: 2rpx;
  transform: translateY(-2rpx) rotate(-45deg);
}
.visit-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.visit-code {
  display: block;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}
.visit-college {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.join-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 46rpx 0;
  background: #fff;
  border: 2rpx dashed var(--primary-light);
  border-radius: 24rpx;
}
.join-hint:active { background: var(--primary-bg); }
.join-hint-title {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 600;
}
.join-hint-sub {
  font-size: 23rpx;
  color: var(--primary);
  font-weight: 500;
}
.empty-mini {
  padding: 52rpx 0;
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(30, 41, 59, 0.06);
}
.empty-mini-text {
  font-size: 25rpx;
  color: var(--text-3);
}

/* ---------- 待办事项 ---------- */
.todo-section {
  margin-top: 46rpx;
}
.section-btn {
  border: 1rpx solid rgba(99, 102, 241, 0.28);
  border-radius: 999rpx;
  padding: 9rpx 26rpx;
  background: rgba(255, 255, 255, 0.9);
}
.section-btn:active { background: var(--primary-bg); }
.section-btn-text {
  font-size: 22rpx;
  color: var(--primary);
}
.todo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 84rpx 0 70rpx;
  box-shadow: 0 12rpx 30rpx rgba(30, 41, 59, 0.06);
}
.todo-empty-icon {
  width: 104rpx;
  height: 126rpx;
  border: 4rpx solid #e4eaf6;
  border-radius: 14rpx;
  position: relative;
  margin-bottom: 28rpx;
  background: #fbfcff;
}
.clip-top {
  position: absolute;
  left: 50%;
  top: -18rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 24rpx;
  border: 4rpx solid #e4eaf6;
  border-radius: 8rpx;
  background: #fff;
}
.clip-check {
  position: absolute;
  left: 32rpx;
  top: 46rpx;
  width: 34rpx;
  height: 20rpx;
  border-left: 5rpx solid var(--success);
  border-bottom: 5rpx solid var(--success);
  transform: rotate(-45deg);
  border-radius: 2rpx;
}
.todo-empty-text {
  font-size: 25rpx;
  color: var(--text-4);
}

/* ---------- 待办列表 ---------- */
.recent-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(30, 41, 59, 0.06);
}
.recent-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f4f6fb;
}
.recent-item:last-child { border-bottom: none; }
.recent-item:active { background: #f8fafc; }
.recent-type {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: var(--primary-bg);
  color: var(--primary-dark);
}
.recent-type.homework {
  background: var(--warning-bg);
  color: var(--warning);
}
.recent-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}
.recent-title {
  font-size: 27rpx;
  color: var(--text-1);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-course {
  font-size: 22rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.recent-status {
  font-size: 21rpx;
  color: var(--text-4);
  flex-shrink: 0;
  margin-left: 12rpx;
}
.recent-status.active {
  color: var(--success);
  font-weight: 600;
}
.recent-time {
  font-size: 20rpx;
  color: var(--text-4);
}

/* ---------- 教师统计 ---------- */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.stat-card {
  flex: 1;
  border-radius: 22rpx;
  padding: 26rpx 8rpx;
  text-align: center;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(30, 41, 59, 0.06);
}
.stat-card:nth-child(1) { background: linear-gradient(135deg, #eef2ff, #e0e7ff); }
.stat-card:nth-child(2) { background: linear-gradient(135deg, #ecfdf5, #d1fae5); }
.stat-card:nth-child(3) { background: linear-gradient(135deg, #fffbeb, #fef3c7); }
.stat-num {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--text-1);
  line-height: 1.2;
}
.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

/* ---------- 教学管理 ---------- */
.action-section {
  margin-top: 40rpx;
}
.action-grid {
  display: flex;
  gap: 18rpx;
}
.action-grid.quad {
  flex-wrap: wrap;
}
.action-grid.quad .action-item {
  flex: 0 0 calc(50% - 9rpx);
}
.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 34rpx 12rpx 30rpx;
  box-shadow: 0 10rpx 26rpx rgba(30, 41, 59, 0.06);
}
.action-item:active {
  transform: scale(0.97);
  background: #f8fafc;
}
.action-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}
.action-icon-wrap.scan { background: linear-gradient(135deg, #eef2ff, #e0e7ff); }
.action-icon-wrap.checkin { background: linear-gradient(135deg, #ecfdf5, #d1fae5); }
.action-icon-wrap.course { background: linear-gradient(135deg, #fffbeb, #fef3c7); }
.action-icon-wrap.checkin-mgmt { background: linear-gradient(135deg, #eef2ff, #e0e7ff); }
.action-icon-wrap.review { background: linear-gradient(135deg, #fef2f2, #fee2e2); }

.icon-scan {
  width: 46rpx; height: 46rpx;
  border: 4rpx solid #6366f1;
  border-radius: 10rpx;
  position: relative;
}
.icon-scan::before {
  content: '';
  position: absolute;
  left: 10rpx; top: 10rpx;
  width: 16rpx; height: 16rpx;
  border: 3rpx solid #6366f1;
  border-radius: 3rpx;
}
.icon-checkin {
  width: 44rpx; height: 44rpx;
  border: 4rpx solid #10b981;
  border-radius: 50%;
  position: relative;
}
.icon-checkin::before {
  content: '';
  position: absolute;
  left: 22rpx; top: 6rpx;
  width: 3rpx; height: 20rpx;
  background: #10b981;
  transform-origin: bottom center;
  transform: rotate(-45deg);
}
.icon-course-mgmt {
  width: 44rpx; height: 34rpx;
  border: 3rpx solid #f59e0b;
  border-radius: 6rpx;
  position: relative;
}
.icon-course-mgmt::before {
  content: '';
  position: absolute;
  left: 9rpx; top: 9rpx;
  width: 20rpx; height: 3rpx;
  background: #f59e0b;
}
.icon-review {
  width: 44rpx; height: 44rpx;
  border: 3rpx solid #ef4444;
  border-radius: 50%;
  position: relative;
}
.icon-review::before {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx; height: 16rpx;
  border: 3rpx solid #ef4444;
  border-radius: 50%;
}
.icon-checkin-mgmt {
  width: 44rpx; height: 44rpx;
  border: 3rpx solid #6366f1;
  border-radius: 50%;
  position: relative;
}
.icon-checkin-mgmt::before {
  content: '';
  position: absolute;
  left: 50%; top: 8rpx;
  transform: translateX(-50%);
  width: 3rpx; height: 15rpx;
  background: #6366f1;
}
.icon-checkin-mgmt::after {
  content: '';
  position: absolute;
  left: 8rpx; top: 50%;
  transform: translateY(-50%);
  width: 15rpx; height: 3rpx;
  background: #6366f1;
}
.icon-chat {
  width: 46rpx; height: 38rpx;
  border: 3rpx solid #6366f1;
  border-radius: 10rpx;
  position: relative;
}
.icon-chat::before {
  content: '';
  position: absolute;
  left: 10rpx; bottom: -10rpx;
  width: 0; height: 0;
  border-left: 0 solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #6366f1;
}
.icon-chat::after {
  content: '';
  position: absolute;
  left: 9rpx; top: 14rpx;
  width: 24rpx; height: 3rpx;
  background: #6366f1;
  box-shadow: 0 8rpx 0 #6366f1;
}

.action-text {
  font-size: 29rpx;
  color: var(--text-1);
  font-weight: 600;
}
.action-desc {
  font-size: 21rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

/* ---------- 教师动态 ---------- */
.recent-section {
  margin-top: 40rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-box-icon {
  width: 110rpx;
  height: 92rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 26rpx;
  color: var(--text-3);
}