.page { padding: 24rpx; background: var(--bg-page); min-height: 100vh; }

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 22rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.4rpx;
}
.sub-title { font-size: 22rpx; color: var(--text-3); }

.loading-tip { text-align: center; padding: 80rpx 0; color: var(--text-3); font-size: 26rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-box-icon {
  width: 110rpx; height: 92rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-text { font-size: 26rpx; color: var(--text-3); }

.quiz-list { display: flex; flex-direction: column; gap: 20rpx; }

.quiz-card {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
  box-shadow: var(--shadow-sm);
}
.quiz-card:active { transform: scale(0.985); }

.qz-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.qz-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.4;
}
.qz-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.qz-status.draft { background: #f1f5f9; color: #64748b; }
.qz-status.published { background: var(--primary-bg); color: var(--primary); }
.qz-status.active { background: #fef3c7; color: #b45309; }
.qz-status.waiting { background: #e0e7ff; color: #4338ca; }
.qz-status.done { background: var(--success-bg); color: var(--success); }
.qz-status.ended { background: var(--danger-bg); color: var(--danger); }

.qz-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.qz-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.qz-meta-item {
  font-size: 22rpx;
  color: var(--text-3);
  background: #f8fafc;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}
.qz-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.qz-time { font-size: 23rpx; color: var(--text-3); }
.qz-score { font-size: 26rpx; font-weight: 600; color: var(--primary); }

/* 详情弹窗 */
.modal { max-height: 78vh; display: flex; flex-direction: column; padding: 30rpx 26rpx 24rpx; }
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.modal-title { flex: 1; font-size: 30rpx; font-weight: 700; color: var(--text-1); text-align: left; }
.modal-close { font-size: 40rpx; color: var(--text-3); padding: 0 8rpx; line-height: 1; }

.modal-body { flex: 1; max-height: 52vh; }

.qd-meta { display: flex; gap: 16rpx; font-size: 23rpx; color: var(--text-3); margin-bottom: 20rpx; }

.qd-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.qd-title { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.qd-no { font-size: 26rpx; font-weight: 700; color: var(--primary); }
.qd-type {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}
.qd-score { margin-left: auto; font-size: 22rpx; color: var(--text-3); }
.qd-content { display: block; font-size: 27rpx; color: var(--text-1); line-height: 1.6; }

.qd-options { margin-top: 12rpx; display: flex; flex-direction: column; gap: 10rpx; }
.qd-option {
  display: flex;
  gap: 10rpx;
  font-size: 25rpx;
  color: var(--text-2);
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}
.qd-option.correct { background: var(--success-bg); color: var(--success); font-weight: 600; }
.qd-option-label { font-weight: 600; }

.qd-blank { margin-top: 12rpx; font-size: 25rpx; color: var(--success); }
.qd-blank-label { color: var(--text-3); }

.qd-analysis {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  line-height: 1.6;
}
.qd-analysis-label { color: var(--primary); font-weight: 600; }

.modal-foot { display: flex; gap: 16rpx; margin-top: 22rpx; }
.modal-foot .btn-primary, .modal-foot .btn-ghost {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
}