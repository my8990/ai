.auth-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #eef2ff 0%, #f5f7fb 42%);
}

.auth-card {
  width: 100%;
  padding: 48rpx 36rpx 40rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

.auth-title {
  display: block;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.5rpx;
  margin-bottom: 8rpx;
}

.auth-subtitle {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 44rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 25rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f8fafc;
  transition: all 0.2s ease;
}

.radio-item {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.btn-primary {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  margin-top: 16rpx;
  padding: 0;
}

.btn-primary::after {
  border: none;
}

.auth-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 32rpx;
}

.auth-link {
  color: var(--primary);
  font-weight: 600;
}