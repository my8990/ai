.page { padding: 24rpx; background: var(--bg-page); min-height: 100vh; }

.rule-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 16rpx;
  display: block;
}
.rule-row { display: flex; align-items: center; margin-bottom: 12rpx; }
.rule-label { width: 140rpx; font-size: 25rpx; color: var(--text-2); flex-shrink: 0; }
.rule-slider { flex: 1; }
.rule-val { width: 80rpx; text-align: right; font-size: 27rpx; font-weight: 700; color: var(--text-1); }

.btn-save {
  background: var(--primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  margin-top: 20rpx;
}
.btn-save:active { opacity: 0.88; }

.score-section { margin-top: 12rpx; }
.section-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.btn-export {
  font-size: 23rpx;
  color: var(--success);
  background: var(--success-bg);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.loading-tip { text-align: center; padding: 80rpx 0; color: var(--text-3); font-size: 26rpx; }
.empty-tip { text-align: center; padding: 60rpx 0; color: var(--text-3); font-size: 26rpx; }

.score-list { display: flex; flex-direction: column; gap: 16rpx; }
.score-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
}
.score-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.score-name { font-size: 28rpx; font-weight: 600; color: var(--text-1); }
.score-no { font-size: 21rpx; color: var(--text-3); margin-left: auto; }

.score-detail { margin-bottom: 12rpx; }
.score-item { display: flex; padding: 6rpx 0; }
.item-label { width: 80rpx; font-size: 23rpx; color: var(--text-3); }
.item-val { font-size: 23rpx; color: var(--text-2); }

.score-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  border-top: 1rpx solid #f4f6fb;
  padding-top: 16rpx;
}
.total-label { font-size: 25rpx; color: var(--text-2); margin-right: 16rpx; }
.total-val { font-size: 38rpx; font-weight: 700; color: var(--primary); letter-spacing: -0.5rpx; }