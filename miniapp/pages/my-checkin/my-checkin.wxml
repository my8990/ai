<view class="page">
  <status-bar />
  <view class="header">
    <text class="title">我的签到</text>
    <text class="subtitle">输入签到码或扫码完成签到</text>
  </view>

  <view wx:if="{{hasQr}}" class="scan-bar">
    <button class="scan-btn" type="primary" bindtap="handleScan">
      <text class="scan-icon">📷</text> 扫码签到
    </button>
  </view>

  <view wx:if="{{activeCount > 1}}" class="pending-tip">
    <text class="pending-dot"></text>
    <text class="pending-text">有 {{activeCount}} 个待签到活动</text>
  </view>

  <view wx:if="{{checkins.length === 0 && !loading}}" class="empty">
    <view class="empty-icon"></view>
    <text class="empty-title">暂无待签到活动</text>
    <text class="empty-desc">老师发布签到后会显示在这里</text>
  </view>

  <view class="checkin-list">
    <view wx:for="{{checkins}}" wx:key="id" id="ck-{{item.id}}" class="checkin-card {{item.pending ? 'is-pending' : ''}}">
      <view class="card-top">
        <text class="card-title">{{item.title}}</text>
        <text class="card-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view class="card-meta">
        <text class="tag {{item.isQr ? 'tag-qr' : 'tag-num'}}">{{item.typeText}}</text>
        <text class="card-course">{{item.courseName}}</text>
      </view>

      <view class="card-sub">
        <text class="card-time">{{item.createTime}}</text>
        <text wx:if="{{item.expireText}}" class="card-expire">{{item.expireText}}</text>
      </view>

      <view wx:if="{{item.lateTip || item.progressText}}" class="card-foot">
        <text wx:if="{{item.lateTip}}" class="foot-late">{{item.lateTip}}</text>
        <text wx:if="{{item.progressText}}" class="foot-progress">{{item.progressText}}</text>
      </view>

      <view wx:if="{{item.pending && item.isNumber}}" class="card-action-wrap">
        <view class="card-action">
          <input
            class="code-input {{inputErrors[item.id] ? 'is-error' : ''}}"
            value="{{inputCodes[item.id]}}"
            bindinput="onCodeInput"
            data-id="{{item.id}}"
            focus="{{focusId === item.id}}"
            placeholder="输入6位签到码"
            maxlength="6"
            type="number" />
          <button
            class="btn-code"
            loading="{{submittingId === item.id}}"
            bindtap="handleSubmit"
            data-id="{{item.id}}">签到</button>
          <button
            wx:if="{{item.dual}}"
            class="btn-scan-link"
            bindtap="goScan">扫码</button>
        </view>
        <view wx:if="{{inputErrors[item.id]}}" class="card-error">{{inputErrors[item.id]}}</view>
      </view>

      <view wx:if="{{item.pending && item.isQr && !item.isNumber}}" class="card-action qr-action">
        <text class="qr-tip">该活动需扫码完成签到</text>
        <button class="btn-qr" bindtap="goScan">打开相机</button>
      </view>
    </view>
  </view>
</view>

<notice-popup id="noticePopup" />