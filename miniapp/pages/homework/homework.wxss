.page { padding: 24rpx; background: var(--bg-page); min-height: 100vh; }

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 22rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.4rpx;
}
.btn-create {
  font-size: 24rpx;
  color: #fff;
  background: var(--primary);
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.btn-create:active { opacity: 0.88; }

.loading-tip { text-align: center; padding: 80rpx 0; color: var(--text-3); font-size: 26rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-box-icon {
  width: 110rpx; height: 92rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-text { font-size: 26rpx; color: var(--text-3); }

.hw-list { display: flex; flex-direction: column; gap: 16rpx; }
.hw-card {
  display: flex;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  overflow: hidden;
  transition: background 0.2s ease;
}
.hw-card:active { background: #f8fafc; }
.hw-left-bar { display: none; }
.hw-body { flex: 1; padding: 24rpx; }
.hw-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  gap: 12rpx;
}
.hw-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hw-status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  font-weight: 500;
}
.hw-status.active { background: var(--success-bg); color: var(--success); }
.hw-status.ended { background: #f1f5f9; color: var(--text-3); }
.hw-info { margin-bottom: 12rpx; }
.hw-desc {
  font-size: 23rpx;
  color: var(--text-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.6;
}
.hw-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx solid #f4f6fb;
}
.hw-meta { font-size: 22rpx; color: var(--primary-dark); font-weight: 600; }
.hw-time { font-size: 21rpx; color: var(--text-3); }

.form-item { display: flex; align-items: center; padding: 16rpx 0; gap: 16rpx; }
.form-item.col { flex-direction: column; align-items: flex-start; }
.form-item .label { font-size: 25rpx; color: var(--text-2); width: 80rpx; flex-shrink: 0; }
.form-item .input {
  flex: 1;
  font-size: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  background: #f8fafc;
}
.form-item .textarea {
  width: 100%;
  font-size: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  background: #f8fafc;
  min-height: 120rpx;
  margin-top: 8rpx;
  box-sizing: border-box;
}
.picker-val { font-size: 26rpx; color: var(--text-1); }
.btn-cancel {
  font-size: 25rpx;
  color: var(--text-2);
  padding: 14rpx 36rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}
.btn-confirm {
  font-size: 25rpx;
  color: #fff;
  padding: 14rpx 36rpx;
  border-radius: 12rpx;
  background: var(--primary);
}