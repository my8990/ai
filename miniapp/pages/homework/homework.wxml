<view class="page">
  <status-bar />
  <view class="header-bar">
    <text class="title">作业列表</text>
    <view wx:if="{{isTeacher}}" class="btn-create" bindtap="showCreate">+ 发布作业</view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <view class="empty-box-icon"></view>
    <text class="empty-text">暂无作业</text>
  </view>

  <view wx:else class="hw-list">
    <view wx:for="{{list}}" wx:key="id" class="hw-card" bindtap="goDetail" data-id="{{item.id}}">
      <view class="hw-left-bar {{item.expired ? 'ended' : 'active'}}"></view>
      <view class="hw-body">
        <view class="hw-top">
          <text class="hw-title">{{item.title}}</text>
          <text class="hw-status {{item.expired ? 'ended' : 'active'}}">{{item.expired ? '已截止' : '进行中'}}</text>
        </view>
        <view class="hw-info">
          <text class="hw-desc">{{item.description || '无要求'}}</text>
        </view>
        <view class="hw-bottom">
          <text class="hw-meta">提交 {{item.submitCount}}/{{item.totalStudents}}</text>
          <text class="hw-time">{{item.createTime}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{createVisible}}" class="modal-mask" bindtap="hideCreate">
    <view class="modal" catchtap="preventBubble">
      <text class="modal-title">发布作业</text>
      <view class="form-item">
        <text class="label">标题</text>
        <input class="input" placeholder="例: 第3周课后作业" value="{{createForm.title}}" bindinput="onTitleInput" />
      </view>
      <view class="form-item col">
        <text class="label">要求</text>
        <textarea class="textarea" placeholder="作业要求描述" value="{{createForm.description}}" bindinput="onDescInput" />
      </view>
      <view class="form-item">
        <text class="label">截止</text>
        <picker mode="date" value="{{createForm.deadline}}" bindchange="onDeadlineChange">
          <text class="picker-val">{{createForm.deadline || '不限制'}}</text>
        </picker>
      </view>
      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideCreate">取消</view>
        <view class="btn-confirm" bindtap="handleCreate">发布</view>
      </view>
    </view>
  </view>
</view>