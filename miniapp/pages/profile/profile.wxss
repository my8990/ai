.profile { padding: 0 24rpx; }

.user-card {
  margin: -20rpx -24rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.user-bg { display: none; }
.user-content {
  display: flex;
  align-items: center;
  padding: 44rpx 28rpx 36rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  flex-shrink: 0;
}
.avatar-text {
  font-size: 46rpx;
  color: var(--primary-dark);
  font-weight: 700;
}
.user-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}
.user-name {
  font-size: 36rpx;
  color: var(--text-1);
  font-weight: 700;
  letter-spacing: -0.3rpx;
}
.role-tag {
  display: inline-flex;
  align-self: flex-start;
  font-size: 20rpx;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  color: var(--text-3);
  background: #f1f5f9;
}
.role-student { color: var(--success); background: var(--success-bg); }
.role-teacher { color: var(--warning); background: var(--warning-bg); }
.role-admin { color: var(--danger); background: var(--danger-bg); }

.menu-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 26rpx;
  border-bottom: 1rpx solid #f4f6fb;
  transition: background 0.2s ease;
}
.menu-item:active { background: #f8fafc; }
.menu-item:last-child { border-bottom: none; }

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.review-icon {
  border: 2rpx solid #f59e0b;
  border-radius: 50%;
}
.checkin-icon {
  border: 2rpx solid #6366f1;
  border-radius: 50%;
  position: relative;
}
.checkin-icon::before {
  content: '';
  position: absolute;
  left: 50%; top: 5rpx;
  transform: translateX(-50%);
  width: 2rpx; height: 11rpx;
  background: #6366f1;
}
.checkin-icon::after {
  content: '';
  position: absolute;
  left: 5rpx; top: 50%;
  transform: translateY(-50%);
  width: 11rpx; height: 2rpx;
  background: #6366f1;
}
.appeal-icon {
  border: 2rpx solid #8b5cf6;
  border-radius: 6rpx;
}
.logout-icon {
  border: 2rpx solid #ef4444;
  border-radius: 50%;
  position: relative;
}
.logout-icon::before {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
  width: 18rpx; height: 2rpx;
  background: #ef4444;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.logout-text { color: var(--danger); }

.menu-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #cbd5e1;
  border-right: 2rpx solid #cbd5e1;
  transform: rotate(45deg);
  flex-shrink: 0;
}