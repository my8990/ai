.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fb;
}

.config-tip {
  margin: 20rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: #fffbeb;
  border: 2rpx solid #fde68a;
  border-radius: 16rpx;
}

.config-tip-text {
  font-size: 24rpx;
  color: #b45309;
  line-height: 1.5;
}

.chat-messages {
  flex: 1;
  padding: 24rpx;
}

.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: #94a3b8;
  margin-bottom: 36rpx;
}

.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  padding: 0 24rpx;
}

.chip {
  padding: 12rpx 24rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.msg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-user {
  background: var(--primary);
}

.avatar-ai {
  background: var(--success);
}

.avatar-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

.msg-bubble {
  max-width: 100%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-body {
  max-width: 76%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-ai .msg-body {
  align-items: flex-start;
}

.msg-user .msg-body {
  align-items: flex-end;
}

.msg-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 8rpx;
}

.meta-user {
  justify-content: flex-end;
}

.msg-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.msg-copy {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
}

.msg-rich {
  font-size: 28rpx;
  line-height: 1.6;
  color: #1e293b;
}

.regenerate-row {
  display: flex;
  justify-content: center;
  padding: 4rpx 0 24rpx;
}

.regenerate-btn {
  font-size: 24rpx;
  color: var(--primary-dark);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--primary-bg);
}

.bubble-user {
  background: var(--primary);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.bubble-ai {
  background: #fff;
  color: var(--text-1);
  border: 1rpx solid var(--line);
  border-bottom-left-radius: 8rpx;
}

.msg-content {
  white-space: pre-wrap;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #6366f1;
  border-radius: 50%;
  animation: dot-bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.chat-input {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
  align-items: center;
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 0 8rpx;
  flex-shrink: 0;
}

.clear-btn.disabled {
  opacity: 0.4;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 28rpx;
}

.send-btn {
  height: 72rpx;
  padding: 0 32rpx;
  background: var(--primary);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn.disabled {
  opacity: 0.5;
  box-shadow: none;
}

.stop-btn {
  background: #fff;
  border: 1rpx solid var(--primary);
}

.stop-btn .send-text {
  color: var(--primary);
}

.send-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}