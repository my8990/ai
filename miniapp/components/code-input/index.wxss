.code-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-card {
  width: 620rpx;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.16);
  animation: code-pop 0.18s ease-out;
}

@keyframes code-pop {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.code-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.code-subtitle {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8f959e;
}

.code-boxes {
  position: relative;
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.code-boxes.is-error {
  animation: code-shake 0.32s ease;
}

@keyframes code-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

.code-box {
  width: 76rpx;
  height: 92rpx;
  border-radius: 14rpx;
  border: 2rpx solid #e5e6eb;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2329;
}

.code-box.is-active {
  border-color: #3370ff;
  background: #f2f5ff;
}

.code-boxes.is-error .code-box {
  border-color: #f54a45;
  background: #fff6f5;
}

.code-hidden-input {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.code-error {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #f54a45;
}

.code-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.code-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.code-btn.ghost {
  background: #f2f3f5;
  color: #4e5969;
}

.code-btn.primary {
  background: #3370ff;
  color: #ffffff;
}

.code-btn.disabled {
  opacity: 0.6;
}