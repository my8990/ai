.notice-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-card {
  width: 560rpx;
  padding: 48rpx 40rpx 40rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.16);
  text-align: center;
  animation: notice-pop 0.18s ease-out;
}

@keyframes notice-pop {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.notice-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.notice-icon.error {
  background: #f04438;
}

.notice-icon.success {
  background: #12b76a;
}

.notice-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.notice-title.error {
  color: #d92d20;
}

.notice-content {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #646a73;
}

.notice-action {
  margin-top: 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.notice-action.error {
  background: #f04438;
}