page {
  --primary: #6366f1;
  --primary-dark: #4f46e5;
  --primary-light: #818cf8;
  --primary-bg: #eef2ff;
  --success: #10b981;
  --success-bg: #ecfdf5;
  --warning: #f59e0b;
  --warning-bg: #fffbeb;
  --danger: #ef4444;
  --danger-bg: #fef2f2;
  --text-1: #1e293b;
  --text-2: #475569;
  --text-3: #94a3b8;
  --text-4: #cbd5e1;
  --line: #eff2f8;
  --bg-page: #f5f7fb;
  --bg-card: #ffffff;

  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--text-1);
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.page-container {
  padding-bottom: 150rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 26rpx;
  transition: all 0.2s ease;
}

.card-hover:active {
  transform: scale(0.985);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 18rpx;
  letter-spacing: -0.2rpx;
}

/* ---------- 列表行 ---------- */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  font-size: 27rpx;
  color: var(--text-2);
}

.cell-value {
  font-size: 27rpx;
  color: var(--text-1);
  font-weight: 500;
}

.cell-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-4);
  border-right: 3rpx solid var(--text-4);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 180rpx;
  height: 150rpx;
  margin-bottom: 24rpx;
  opacity: 0.35;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
  margin-bottom: 24rpx;
}

.empty-btn {
  font-size: 26rpx;
  color: var(--primary);
  padding: 12rpx 36rpx;
  border: 2rpx solid var(--primary);
  border-radius: 40rpx;
}

.color-bar-0 { border-left-color: #6366f1; }
.color-bar-1 { border-left-color: #f59e0b; }
.color-bar-2 { border-left-color: #10b981; }
.color-bar-3 { border-left-color: #ef4444; }
.color-bar-4 { border-left-color: #8b5cf6; }
.color-bar-5 { border-left-color: #ec4899; }
.color-bar-6 { border-left-color: #06b6d4; }
.color-bar-7 { border-left-color: #f97316; }

/* ---------- 按钮 ---------- */
.btn-primary {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  padding: 0;
}

.btn-primary::after {
  border: none;
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
}

.btn-ghost {
  background: var(--primary-bg);
  color: var(--primary-dark);
  font-size: 26rpx;
  font-weight: 500;
  padding: 12rpx 28rpx;
  border-radius: 14rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.tag-success { background: var(--success-bg); color: var(--success); }
.tag-warning { background: var(--warning-bg); color: var(--warning); }
.tag-danger { background: var(--danger-bg); color: var(--danger); }
.tag-info { background: #f1f5f9; color: #6b7280; }
.tag-primary { background: var(--primary-bg); color: var(--primary); }

/* ---------- 弹窗 ---------- */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

.modal {
  width: 100%;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 36rpx 30rpx 30rpx;
}

.modal-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 32rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #f1f5f9;
  color: var(--text-2);
}

.modal-btn.confirm {
  background: var(--primary);
  color: #fff;
}

/* ---------- 表单 ---------- */
.form-item {
  margin-bottom: 26rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid #e8ecf3;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-1);
  transition: all 0.2s ease;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid #e8ecf3;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-1);
}

.form-tip {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: -8rpx;
}

/* ---------- 骨架：轻量头部 ---------- */
.lite-header {
  padding: 10rpx 0 20rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 22rpx;
}

.lite-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lite-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.4rpx;
}

.lite-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.lite-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lite-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-dark);
}

/* ---------- 骨架：平面卡片 ---------- */
.surface {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
}

.surface-flat {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  overflow: hidden;
}

.surface + .surface {
  margin-top: 20rpx;
}

/* ---------- 骨架：列表行 ---------- */
.list-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f4f6fb;
  transition: background 0.2s ease;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row:active {
  background: #f8fafc;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  flex-shrink: 0;
}

/* ---------- 骨架：指标与细进度条 ---------- */
.metric-row {
  padding: 20rpx 0;
}

.metric-row:last-child {
  padding-bottom: 0;
}

.metric-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.metric-name {
  font-size: 24rpx;
  color: var(--text-2);
}

.metric-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-1);
}

.thin-bar {
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--primary-bg);
  overflow: hidden;
}

.thin-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: var(--primary);
  transition: width 0.4s ease;
}

.thin-bar-fill.success { background: var(--success); }
.thin-bar-fill.warning { background: var(--warning); }
.thin-bar-fill.danger { background: var(--danger); }

/* ---------- 骨架：权重 chip ---------- */
.weight-chip {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: var(--primary-bg);
  color: var(--primary-dark);
  flex-shrink: 0;
}

/* ---------- 骨架：实心主按钮 ---------- */
.btn-solid {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 14rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-solid:active {
  opacity: 0.88;
}

.btn-quiet {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: var(--text-2);
  font-size: 28rpx;
  font-weight: 500;
}

.btn-quiet:active {
  opacity: 0.88;
}